---
import Layout from '../layouts/Layout.astro';
import publications from '../data/publications.json';

const grouped = publications.reduce((acc, pub) => {
    const year = pub.year || 'Unknown';
    if (!acc[year]) {
        acc[year] = [];
    }
    acc[year].push(pub);
    return acc;
}, {} as Record<string, any[]>);

const years = Object.keys(grouped).sort((a, b) => Number(b) - Number(a));
---

<Layout title="Publications">
    <h1 class="text-gradient">Publications</h1>

    {years.map(year => (
        <h2 style="border-bottom: 1px solid var(--border); padding-bottom: 10px; margin-top: 40px;" class="text-gradient">
            {year}
        </h2>

        <div class="publications-list">
            {grouped[year].map(pub => (
                <div style="display: flex; gap: 20px; margin-bottom: 2rem; background: var(--surface-hover); padding: 1.5rem; border-radius: var(--radius); border: 1px solid var(--border);">
                    {pub.image && (
                        <div style="flex: 0 0 150px;">
                            <img src={pub.image.startsWith('/') ? pub.image : `/${pub.image}`} alt="Teaser" style="width: 100%; border-radius: 4px; border: 1px solid var(--border);" />
                        </div>
                    )}
                    <div style="flex: 1;">
                        <h3 style="margin-top: 0; margin-bottom: 5px;">
                            <a href={pub.pdf} target="_blank" rel="noopener noreferrer">{pub.title}</a>
                        </h3>
                        <div style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 0.5rem;" set:html={pub.authors.replace(/\*\*(.*?)\*\*/g, '<strong style="color: var(--text);">$1</strong>')} />
                        <div style="font-style: italic; color: var(--text-muted);">
                            {pub.venue}
                        </div>
                        <div style="margin-top: 12px; display: flex; gap: 0.5rem;">
                            {pub.pdf && <a href={pub.pdf} target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="padding: 0.3rem 0.8rem; font-size: 0.85rem;">PDF</a>}
                            {pub.code && <a href={pub.code} target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="padding: 0.3rem 0.8rem; font-size: 0.85rem;">Code</a>}
                            {pub.project && <a href={pub.project} target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="padding: 0.3rem 0.8rem; font-size: 0.85rem;">Project</a>}
                        </div>
                    </div>
                </div>
            ))}
        </div>
    ))}
</Layout>

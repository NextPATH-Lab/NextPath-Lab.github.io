---
import Layout from '../layouts/Layout.astro';
import people from '../data/people.json';

const DEFAULT_AVATAR = '/images/people/generic_avatar.jpeg';

// Bios live as markdown in src/data/people_blurbs/; people.json points at the filename.
const blurbs = import.meta.glob<{ compiledContent: () => string }>(
    '../data/people_blurbs/*.md',
    { eager: true }
);

const blurbHtml = (person: { name: string; blurb?: string | null }) => {
    if (!person.blurb) return '';
    const mod = blurbs[`../data/people_blurbs/${person.blurb}`];
    if (!mod) {
        console.warn(`[people] missing blurb file for ${person.name}: ${person.blurb}`);
        return '';
    }
    return mod.compiledContent();
};

// Section order on the page. `group` in people.json must match one of these ids.
const sections = [
    { id: 'pi', heading: 'Principal Investigators', empty: 'No principal investigators listed currently.' },
    { id: 'staff', heading: 'Staff', empty: 'No staff listed currently.' },
    { id: 'student', heading: 'Students', empty: 'No students listed currently.' },
    { id: 'alumni', heading: 'Alumni', empty: null },
];

const membersOf = (id: string) =>
    people
        .filter(person => person.group === id)
        .sort((a, b) => (a.order ?? 99) - (b.order ?? 99) || a.name.localeCompare(b.name));
---

<Layout title="People">
    <h1 class="text-gradient">Lab Members</h1>

    {sections.map(section => {
        const members = membersOf(section.id);
        if (members.length === 0 && !section.empty) return null;

        return (
            <section style="margin-bottom: 3rem;">
                <h2>{section.heading}</h2>

                {members.length === 0 ? (
                    <p style="color: var(--text-muted);">{section.empty}</p>
                ) : (
                    members.map(person => (
                        <div style="display: flex; gap: 2rem; margin-bottom: 2rem; align-items: flex-start; flex-wrap: wrap;">
                            <img
                                src={person.image || DEFAULT_AVATAR}
                                alt={person.name}
                                style="width: 200px; border: 1px solid var(--border); border-radius: var(--radius);"
                            />
                            <div style="flex: 1;">
                                <h3 style="margin-bottom: 0;" class="text-gradient">{person.name}</h3>
                                {person.role && (
                                    <p style="color: var(--text-muted); margin-top: 0;">{person.role}</p>
                                )}
                                <div class="person-bio" set:html={blurbHtml(person)} />
                            </div>
                        </div>
                    ))
                )}
            </section>
        );
    })}
</Layout>

<style>
    /* :global() is needed because the bio HTML comes from set:html, not the template. */
    .person-bio :global(p) {
        text-align: justify;
        margin-top: 0.5rem;
    }
    .person-bio :global(p:last-child) {
        margin-bottom: 0;
    }
</style>

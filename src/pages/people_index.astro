---
import Layout from '../layouts/Layout.astro';
import people from '../data/people.json';

const DEFAULT_AVATAR = '/images/people/generic_avatar.jpeg';

// Bios live as markdown in src/data/people_blurbs/; people.json points at the filename.
const blurbs = import.meta.glob<{ compiledContent: () => string }>(
    '../data/people_blurbs/*.md',
    { eager: true }
);

const blurbHtml = (person: { name: string; blurb?: string | null }) => {
    if (!person.blurb) return '';
    const mod = blurbs[`../data/people_blurbs/${person.blurb}`];
    if (!mod) {
        console.warn(`[people] missing blurb file for ${person.name}: ${person.blurb}`);
        return '';
    }
    return mod.compiledContent();
};

// Profile links, rendered in this order. Keys match the `links` object in people.json;
// anything missing or empty is simply skipped.
const LINK_TYPES = [
    { key: 'website', label: 'Website' },
    { key: 'email', label: 'Email' },
    { key: 'orcid', label: 'ORCID' },
    { key: 'scholar', label: 'Google Scholar' },
    { key: 'linkedin', label: 'LinkedIn' },
    { key: 'github', label: 'GitHub' },
];

const personLinks = (person: { name: string; links?: Record<string, string | undefined> }) => {
    const links = (person.links ?? {}) as Record<string, string | undefined>;
    return LINK_TYPES.filter(({ key }) => links[key]).map(({ key, label }) => {
        const value = links[key] as string;
        const isEmail = key === 'email';
        return {
            key,
            label,
            href: isEmail && !value.startsWith('mailto:') ? `mailto:${value}` : value,
            external: !isEmail,
        };
    });
};

// Section order on the page. `group` in people.json must match one of these ids.
const sections = [
    { id: 'pi', heading: 'Principal Investigators', empty: 'No principal investigators listed currently.' },
    { id: 'staff', heading: 'Staff', empty: 'No staff listed currently.' },
    { id: 'student', heading: 'Students', empty: 'No students listed currently.' },
    { id: 'alumni', heading: 'Alumni', empty: null },
];

const membersOf = (id: string) =>
    people
        .filter(person => person.group === id)
        .sort((a, b) => (a.order ?? 99) - (b.order ?? 99) || a.name.localeCompare(b.name));
---

<Layout title="People">
    <h1 class="text-gradient">Lab Members</h1>

    {sections.map(section => {
        const members = membersOf(section.id);
        if (members.length === 0 && !section.empty) return null;

        return (
            <section style="margin-bottom: 3rem;">
                <h2>{section.heading}</h2>

                {members.length === 0 ? (
                    <p style="color: var(--text-muted);">{section.empty}</p>
                ) : (
                    members.map(person => (
                        <div style="display: flex; gap: 2rem; margin-bottom: 2rem; align-items: flex-start; flex-wrap: wrap;">
                            <img
                                src={person.image || DEFAULT_AVATAR}
                                alt={person.name}
                                style="width: 200px; border: 1px solid var(--border); border-radius: var(--radius);"
                            />
                            <div style="flex: 1;">
                                <h3 style="margin-bottom: 0;" class="text-gradient">{person.name}</h3>
                                {person.role && (
                                    <p style="color: var(--text-muted); margin-top: 0;">{person.role}</p>
                                )}
                                {personLinks(person).length > 0 && (
                                    <div class="person-links">
                                        {personLinks(person).map(link => (
                                            <a
                                                href={link.href}
                                                class="person-link"
                                                target={link.external ? '_blank' : undefined}
                                                rel={link.external ? 'noopener noreferrer' : undefined}
                                            >
                                                {link.label}
                                            </a>
                                        ))}
                                    </div>
                                )}
                                <div class="person-bio" set:html={blurbHtml(person)} />
                            </div>
                        </div>
                    ))
                )}
            </section>
        );
    })}
</Layout>

<style>
    .person-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0.5rem 0 0.25rem;
    }

    .person-link {
        font-size: 0.8rem;
        font-weight: 600;
        line-height: 1;
        padding: 0.35rem 0.7rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--text-muted);
        text-decoration: none;
        transition: var(--transition);
    }

    .person-link:hover {
        color: var(--primary);
        border-color: var(--primary);
        background-color: var(--surface);
        text-decoration: none;
    }

    /* :global() is needed because the bio HTML comes from set:html, not the template. */
    .person-bio :global(p) {
        text-align: justify;
        margin-top: 0.5rem;
    }
    .person-bio :global(p:last-child) {
        margin-bottom: 0;
    }
</style>

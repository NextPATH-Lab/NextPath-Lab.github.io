---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 5); // Get the 5 most recent posts
---

<div class="sidebar card" style="background: var(--surface-hover); padding: 1.5rem; border: 1px solid var(--border); border-radius: var(--radius);">
    <h3 class="text-gradient" style="margin-top: 0; margin-bottom: 1rem; font-size: 1.2rem;">Recent News</h3>
    <div style="display: flex; flex-direction: column; gap: 1rem;">
        {latestPosts.map(post => (
            <div style="border-bottom: 1px solid var(--border); padding-bottom: 1rem;">
                <div style="color: var(--text-muted); font-size: 0.8rem; font-style: italic; margin-bottom: 0.2rem;">
                    {new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </div>
                <a href={`/posts/${post.id}`} style="font-weight: 600; font-size: 0.95rem; line-height: 1.4; display: block;">
                    {post.data.title}
                </a>
            </div>
        ))}
    </div>
    <div style="margin-top: 1rem; text-align: center;">
        <a href="/news" class="btn btn-outline" style="width: 100%; box-sizing: border-box; padding: 0.5rem; font-size: 0.85rem;">View All News</a>
    </div>
</div>
